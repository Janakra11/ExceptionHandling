<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Operational Properties Variables definition -->
    <property name="LOG_PATH" value="/logs" />
    <property name="LOG_FILE_NAME" value="employee-service" />

    <!-- 1. CONSOLE APPENDER: Optimized colorized layout layout for local/Docker stream visibility -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %magenta([%thread]) %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. ROLLING FILE APPENDER: Built for production lifecycle data safety -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</Pattern>
        </encoder>

        <!-- Time and Size-Based Rolling Policy: Triggers rotation daily or when file exceeds 10MB -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/${LOG_FILE_NAME}-%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <!-- Retain up to 30 days of structural history tracing records -->
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 3. ENVIRONMENT SPECIFIC PROFILES SETUPS -->

    <!-- Local Development Profile Logging Setup -->
    <springProfile name="default | dev">
        <logger name="com.example.api.employeeservice" level="DEBUG" />
        <!-- Triggers visibility over Hibernate physical SQL binding statements -->
        <logger name="org.hibernate.SQL" level="DEBUG" />
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" />
        <logger name="org.springframework.data.redis" level="DEBUG" />

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <!-- Production Node Profiles Logging Setup -->
    <springProfile name="prod">
        <logger name="com.example.api.employeeservice" level="INFO" />
        <logger name="org.hibernate.SQL" level="WARN" />
        <logger name="org.springframework.data.redis" level="WARN" />

        <root level="WARN">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

</configuration>
